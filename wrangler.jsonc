// One Cloudflare Worker serves both the app (public/) and its API (/api/*) at
// estate.oneuptech.co, backed by the D1 database "estate-db". See README → Hosting.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "estate",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "minify": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // API calls go to the Worker code; everything else is a static file.
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "estate-db",
      // From `npx wrangler d1 create estate-db` (one-time, see README). Local dev ignores it.
      "database_id": "d995a1cf-2106-44c8-9af8-50f1196e4387",
      "migrations_dir": "migrations"
    }
  ],
  // Requires the oneuptech.co zone to be on the same Cloudflare account (as for fleet.oneuptech.co).
  "routes": [
    { "pattern": "estate.oneuptech.co", "custom_domain": true }
  ],
  "observability": { "enabled": true },
  // Demo / test site: same code, its own Worker, database and address. Set up with
  // `npm run demo:setup`; deploy updates with `npm run demo:deploy`. See README → Demo site.
  "env": {
    "demo": {
      "name": "estate-demo",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "estate-demo-db",
          "database_id": "067faaa1-7c84-4f4e-97c3-3a565823da87",
          "migrations_dir": "migrations"
        }
      ],
      "routes": [
        { "pattern": "estate-demo.oneuptech.co", "custom_domain": true }
      ]
    }
  }
  // JWT_SECRET is NOT set here — it's a secret: `npx wrangler secret put JWT_SECRET`.
}
